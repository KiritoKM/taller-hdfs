<?xml version="1.0"?>
<configuration>
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>file:///data/name</value>
  </property>
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>file:///data/data</value>
  </property>
  <!--
    Replicación 2 con 3 DataNodes: al caer un nodo, HDFS SÍ puede reconstruir la
    segunda réplica en el nodo que queda libre (con replicación 3 y 3 nodos no podría).
  -->
  <property>
    <name>dfs.replication</name>
    <value>2</value>
  </property>
  <!-- Bloques de 1 MiB: un archivo de pocos MiB genera varios bloques y varios map tasks. -->
  <property>
    <name>dfs.blocksize</name>
    <value>1048576</value>
  </property>
  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-address</name>
    <value>namenode:9000</value>
  </property>
  <!--
    Detección de nodos muertos más rápida que el valor por defecto (~10.5 min).
    Tiempo hasta "dead" = 2 * recheck-interval + 10 * heartbeat.interval = 2*30s + 10*3s = 90 s.
  -->
  <property>
    <name>dfs.heartbeat.interval</name>
    <value>3</value>
  </property>
  <property>
    <name>dfs.namenode.heartbeat.recheck-interval</name>
    <value>30000</value>
  </property>
  <!--
    Cada cuánto el NameNode programa la re-replicación de bloques (por defecto 3 s). En cada
    ronda programa ~2 bloques por DataNode vivo; con 3 s la reparación termina en segundos y no
    alcanza a verse en la UI. Con 10 s, ~25 bloques infra-replicados bajan a 0 en ~1 minuto.
  -->
  <property>
    <name>dfs.namenode.redundancy.interval.seconds</name>
    <value>10</value>
  </property>
</configuration>
